{
  "name": "LineasCompra",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "facturaId": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date-time"
    },
    "a\u00f1o": {
      "type": "number"
    },
    "mes": {
      "type": "number"
    },
    "trimestre": {
      "type": "number"
    },
    "proveedorId": {
      "type": "string"
    },
    "estadoPago": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "partial"
      ]
    },
    "fechaVencimiento": {
      "type": "string",
      "format": "date-time"
    },
    "esDevolucion": {
      "type": "boolean",
      "default": false
    },
    "moneda": {
      "type": "string",
      "default": "EUR"
    },
    "tipoCambio": {
      "type": "number",
      "default": 1
    },
    "itemId": {
      "type": "string"
    },
    "itemNombre": {
      "type": "string"
    },
    "unidades": {
      "type": "number"
    },
    "precioUnitario": {
      "type": "number"
    },
    "descuentoPct": {
      "type": "number",
      "default": 0
    },
    "importeBruto": {
      "type": "number"
    },
    "importeNeto": {
      "type": "number"
    },
    "impuestoId": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "tipoGasto": {
      "type": "string"
    },
    "importeNetoEUR": {
      "type": "number"
    },
    "costeTotal": {
      "type": "number"
    },
    "diasHastaVto": {
      "type": "number"
    },
    "estaVencida": {
      "type": "boolean"
    },
    "diasVencida": {
      "type": "number"
    }
  },
  "required": [
    "company_id",
    "facturaId",
    "fecha"
  ]
}